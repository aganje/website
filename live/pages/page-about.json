{"ID":11,"post_author":"1","post_date":"2025-09-01 19:48:53","post_date_gmt":"2025-09-01 19:48:53","post_content":"<!-- wp:group {\"align\":\"full\",\"className\":\"nfd-container is-style-nfd-theme-white\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"72px\",\"right\":\"24px\",\"bottom\":\"72px\",\"left\":\"24px\"},\"blockGap\":\"48px\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"nfd-container is-style-nfd-theme-white wp-block-group alignfull\" style=\"padding-top:72px;padding-right:24px;padding-bottom:72px;padding-left:24px\"><!-- wp:columns {\"verticalAlignment\":\"center\",\"style\":{\"spacing\":{\"blockGap\":{\"top\":\"40px\",\"left\":\"56px\"}}}} -->\n<div class=\"wp-block-columns are-vertically-aligned-center\"><!-- wp:column {\"verticalAlignment\":\"center\",\"width\":\"52%\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\" style=\"flex-basis:52%\"><!-- wp:paragraph {\"className\":\"nfd-text-sm\",\"style\":{\"typography\":{\"textTransform\":\"uppercase\",\"fontStyle\":\"normal\",\"fontWeight\":\"600\",\"letterSpacing\":\"0.08em\"}}} -->\n<p class=\"nfd-text-sm\" style=\"font-style:normal;font-weight:600;letter-spacing:0.08em;text-transform:uppercase\">Innovative AI Solutions<\/p>\n<!-- \/wp:paragraph -->\n\n<!-- wp:heading {\"level\":1,\"className\":\"wp-block-heading nfd-text-huge nfd-text-primary nfd-text-balance\",\"style\":{\"spacing\":{\"margin\":{\"top\":\"12px\",\"bottom\":\"24px\"}}}} -->\n<h1 class=\"wp-block-heading nfd-text-huge nfd-text-primary nfd-text-balance\" id=\"h-ai-powered-clarity-for-smarter-business-decisions\" style=\"margin-top:12px;margin-bottom:24px\">AI-Powered Clarity for Smarter Business Decisions<\/h1>\n<!-- \/wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"nfd-text-md nfd-text-balance nfd-text-faded\",\"style\":{\"spacing\":{\"margin\":{\"bottom\":\"28px\"}}}} -->\n<p class=\"nfd-text-md nfd-text-balance nfd-text-faded\" style=\"margin-bottom:28px\">Aletheon Labs helps organizations transform complex data into actionable intelligence through AI-driven software, advanced analytics, and intelligent automation.<\/p>\n<!-- \/wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"nfd-text-md\",\"style\":{\"spacing\":{\"margin\":{\"bottom\":\"32px\"}}}} -->\n<p class=\"nfd-text-md\" style=\"margin-bottom:32px\">We build intelligent solutions that help businesses understand what is happening, why it is happening, and what actions to take next.<\/p>\n<!-- \/wp:paragraph -->\n\n<!-- wp:buttons {\"style\":{\"spacing\":{\"blockGap\":\"12px\"}}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"is-style-fill\"} -->\n<div class=\"is-style-fill wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"\/solutions\">Explore Solutions<\/a><\/div>\n<!-- \/wp:button -->\n\n<!-- wp:button {\"className\":\"is-style-outline\"} -->\n<div class=\"is-style-outline wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"\/contact\">Connect With Us<\/a><\/div>\n<!-- \/wp:button --><\/div>\n<!-- \/wp:buttons --><\/div>\n<!-- \/wp:column -->\n\n<!-- wp:column {\"verticalAlignment\":\"center\",\"width\":\"48%\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\" style=\"flex-basis:48%\"><!-- wp:columns {\"style\":{\"spacing\":{\"blockGap\":{\"top\":\"12px\",\"left\":\"12px\"}}}} -->\n<div class=\"wp-block-columns\"><!-- wp:column {\"style\":{\"spacing\":{\"blockGap\":\"12px\"}}} -->\n<div class=\"wp-block-column\"><!-- wp:image {\"aspectRatio\":\"4\/5\",\"scale\":\"cover\",\"sizeSlug\":\"large\",\"style\":{\"border\":{\"radius\":\"18px\"}}} -->\n<figure class=\"wp-block-image size-large has-custom-border\"><img src=\"https:\/\/images.unsplash.com\/photo-1504868584819-f8e8b4b6d7e3?ixlib=rb-4.0.3&amp;auto=format&amp;fit=crop&amp;q=60&amp;w=800&amp;h=1000&amp;crop=\" alt=\"Business analytics dashboard and data visualization\" style=\"border-radius:18px;aspect-ratio:4\/5;object-fit:cover\"\/><\/figure>\n<!-- \/wp:image -->\n\n<!-- wp:image {\"aspectRatio\":\"1\",\"scale\":\"cover\",\"sizeSlug\":\"large\",\"style\":{\"border\":{\"radius\":\"18px\"}}} -->\n<figure class=\"wp-block-image size-large has-custom-border\"><img src=\"https:\/\/images.unsplash.com\/photo-1684369175809-f9642140a1bd?ixlib=rb-4.0.3&amp;auto=format&amp;fit=crop&amp;q=60&amp;w=800&amp;h=800&amp;crop=\" alt=\"Modern city and technology environment\" style=\"border-radius:18px;aspect-ratio:1;object-fit:cover\"\/><\/figure>\n<!-- \/wp:image --><\/div>\n<!-- \/wp:column -->\n\n<!-- wp:column {\"style\":{\"spacing\":{\"padding\":{\"top\":\"40px\"}}}} -->\n<div class=\"wp-block-column\" style=\"padding-top:40px\"><!-- wp:image {\"aspectRatio\":\"1\",\"scale\":\"cover\",\"sizeSlug\":\"large\",\"style\":{\"border\":{\"radius\":\"18px\"}}} -->\n<figure class=\"wp-block-image size-large has-custom-border\"><img src=\"https:\/\/images.unsplash.com\/photo-1642177977596-36c73531208d?ixlib=rb-4.0.3&amp;auto=format&amp;fit=crop&amp;q=60&amp;w=800&amp;h=800&amp;crop=\" alt=\"Technology and business intelligence visual\" style=\"border-radius:18px;aspect-ratio:1;object-fit:cover\"\/><\/figure>\n<!-- \/wp:image -->\n\n<!-- wp:image {\"aspectRatio\":\"4\/5\",\"scale\":\"cover\",\"sizeSlug\":\"large\",\"style\":{\"border\":{\"radius\":\"18px\"}}} -->\n<figure class=\"wp-block-image size-large has-custom-border\"><img src=\"https:\/\/images.unsplash.com\/photo-1692607431225-5f4564c8f132?ixlib=rb-4.0.3&amp;auto=format&amp;fit=crop&amp;q=60&amp;w=800&amp;h=1000&amp;crop=\" alt=\"City skyline representing modern business innovation\" style=\"border-radius:18px;aspect-ratio:4\/5;object-fit:cover\"\/><\/figure>\n<!-- \/wp:image --><\/div>\n<!-- \/wp:column --><\/div>\n<!-- \/wp:columns --><\/div>\n<!-- \/wp:column --><\/div>\n<!-- \/wp:columns --><\/div>\n<!-- \/wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"className\":\"nfd-container\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"72px\",\"right\":\"24px\",\"bottom\":\"72px\",\"left\":\"24px\"},\"blockGap\":\"24px\"}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"920px\"}} -->\n<div class=\"nfd-container wp-block-group alignfull\" style=\"padding-top:72px;padding-right:24px;padding-bottom:72px;padding-left:24px\"><!-- wp:heading {\"textAlign\":\"center\",\"className\":\"wp-block-heading nfd-text-xl nfd-text-balance\"} -->\n<h2 class=\"wp-block-heading nfd-text-xl nfd-text-balance has-text-align-center\" id=\"h-turning-complexity-into-clarity\">Turning Complexity into Clarity<\/h2>\n<!-- \/wp:heading -->\n\n<!-- wp:paragraph {\"align\":\"center\",\"className\":\"nfd-text-md nfd-text-faded\"} -->\n<p class=\"nfd-text-md nfd-text-faded has-text-align-center\">Modern businesses operate across disconnected systems, changing markets, and growing volumes of data. Aletheon Labs exists to simplify that complexity.<\/p>\n<!-- \/wp:paragraph -->\n\n<!-- wp:paragraph {\"align\":\"center\",\"className\":\"nfd-text-md\"} -->\n<p class=\"nfd-text-md has-text-align-center\">We combine artificial intelligence, advanced analytics, machine learning, and business context to help organizations move from reactive reporting to proactive decision-making.<\/p>\n<!-- \/wp:paragraph --><\/div>\n<!-- \/wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"className\":\"nfd-container is-style-nfd-theme-light\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"72px\",\"right\":\"24px\",\"bottom\":\"72px\",\"left\":\"24px\"},\"blockGap\":\"40px\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"nfd-container is-style-nfd-theme-light wp-block-group alignfull\" style=\"padding-top:72px;padding-right:24px;padding-bottom:72px;padding-left:24px\"><!-- wp:group {\"layout\":{\"type\":\"constrained\",\"contentSize\":\"760px\"}} -->\n<div class=\"wp-block-group\"><!-- wp:heading {\"textAlign\":\"center\",\"className\":\"wp-block-heading nfd-text-xl nfd-text-balance\"} -->\n<h2 class=\"wp-block-heading nfd-text-xl nfd-text-balance has-text-align-center\" id=\"h-what-we-do\">What We Do<\/h2>\n<!-- \/wp:heading -->\n\n<!-- wp:paragraph {\"align\":\"center\",\"className\":\"nfd-text-md nfd-text-faded\"} -->\n<p class=\"nfd-text-md nfd-text-faded has-text-align-center\">Aletheon Labs develops AI-powered solutions across key business functions.<\/p>\n<!-- \/wp:paragraph --><\/div>\n<!-- \/wp:group -->\n\n<!-- wp:columns {\"style\":{\"spacing\":{\"blockGap\":{\"top\":\"24px\",\"left\":\"24px\"}}}} -->\n<div class=\"wp-block-columns\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:group {\"className\":\"nfd-rounded-lg\",\"style\":{\"border\":{\"radius\":\"18px\"},\"spacing\":{\"padding\":{\"top\":\"32px\",\"right\":\"28px\",\"bottom\":\"32px\",\"left\":\"28px\"},\"blockGap\":\"16px\"},\"color\":{\"background\":\"#ffffff\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"nfd-rounded-lg wp-block-group has-background\" style=\"border-radius:18px;background-color:#ffffff;padding-top:32px;padding-right:28px;padding-bottom:32px;padding-left:28px\"><!-- wp:heading {\"level\":3,\"className\":\"wp-block-heading\"} -->\n<h3 class=\"wp-block-heading\" id=\"h-marketing-intelligence\">Marketing Intelligence<\/h3>\n<!-- \/wp:heading -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Evaluate campaigns, customer behavior, regional trends, market conditions, and messaging performance to improve targeting and business outcomes.<\/p>\n<!-- \/wp:paragraph --><\/div>\n<!-- \/wp:group --><\/div>\n<!-- \/wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:group {\"className\":\"nfd-rounded-lg\",\"style\":{\"border\":{\"radius\":\"18px\"},\"spacing\":{\"padding\":{\"top\":\"32px\",\"right\":\"28px\",\"bottom\":\"32px\",\"left\":\"28px\"},\"blockGap\":\"16px\"},\"color\":{\"background\":\"#ffffff\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"nfd-rounded-lg wp-block-group has-background\" style=\"border-radius:18px;background-color:#ffffff;padding-top:32px;padding-right:28px;padding-bottom:32px;padding-left:28px\"><!-- wp:heading {\"level\":3,\"className\":\"wp-block-heading\"} -->\n<h3 class=\"wp-block-heading\" id=\"h-supply-chain-insights\">Supply Chain Insights<\/h3>\n<!-- \/wp:heading -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Identify demand signals, inventory movement, operational patterns, performance risks, and opportunities to respond faster.<\/p>\n<!-- \/wp:paragraph --><\/div>\n<!-- \/wp:group --><\/div>\n<!-- \/wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:group {\"className\":\"nfd-rounded-lg\",\"style\":{\"border\":{\"radius\":\"18px\"},\"spacing\":{\"padding\":{\"top\":\"32px\",\"right\":\"28px\",\"bottom\":\"32px\",\"left\":\"28px\"},\"blockGap\":\"16px\"},\"color\":{\"background\":\"#ffffff\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"nfd-rounded-lg wp-block-group has-background\" style=\"border-radius:18px;background-color:#ffffff;padding-top:32px;padding-right:28px;padding-bottom:32px;padding-left:28px\"><!-- wp:heading {\"level\":3,\"className\":\"wp-block-heading\"} -->\n<h3 class=\"wp-block-heading\" id=\"h-erp-intelligence\">ERP Intelligence<\/h3>\n<!-- \/wp:heading -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Enhance enterprise data from finance, operations, planning, and ERP systems with actionable business insights.<\/p>\n<!-- \/wp:paragraph --><\/div>\n<!-- \/wp:group --><\/div>\n<!-- \/wp:column --><\/div>\n<!-- \/wp:columns --><\/div>\n<!-- \/wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"className\":\"nfd-container\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"72px\",\"right\":\"24px\",\"bottom\":\"72px\",\"left\":\"24px\"},\"blockGap\":\"40px\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"nfd-container wp-block-group alignfull\" style=\"padding-top:72px;padding-right:24px;padding-bottom:72px;padding-left:24px\"><!-- wp:heading {\"textAlign\":\"center\",\"className\":\"wp-block-heading nfd-text-xl nfd-text-balance\"} -->\n<h2 class=\"wp-block-heading nfd-text-xl nfd-text-balance has-text-align-center\" id=\"h-why-aletheon-labs\">Why Aletheon Labs<\/h2>\n<!-- \/wp:heading -->\n\n<!-- wp:columns {\"style\":{\"spacing\":{\"blockGap\":{\"top\":\"24px\",\"left\":\"24px\"}}}} -->\n<div class=\"wp-block-columns\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":3,\"className\":\"wp-block-heading\"} -->\n<h3 class=\"wp-block-heading\" id=\"h-clarity-over-complexity\">Clarity Over Complexity<\/h3>\n<!-- \/wp:heading -->\n\n<!-- wp:paragraph -->\n<p class=\"\">We turn fragmented data into insights business teams can understand, trust, and act on.<\/p>\n<!-- \/wp:paragraph --><\/div>\n<!-- \/wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":3,\"className\":\"wp-block-heading\"} -->\n<h3 class=\"wp-block-heading\" id=\"h-business-first-ai\">Business-First AI<\/h3>\n<!-- \/wp:heading -->\n\n<!-- wp:paragraph -->\n<p class=\"\">Our solutions are designed around real business decisions, not technology for technology\u2019s sake.<\/p>\n<!-- \/wp:paragraph --><\/div>\n<!-- \/wp:column --><\/div>\n<!-- \/wp:columns -->\n\n<!-- wp:columns {\"style\":{\"spacing\":{\"blockGap\":{\"top\":\"24px\",\"left\":\"24px\"}}}} -->\n<div class=\"wp-block-columns\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":3,\"className\":\"wp-block-heading\"} -->\n<h3 class=\"wp-block-heading\" id=\"h-scalable-software-design\">Scalable Software Design<\/h3>\n<!-- \/wp:heading -->\n\n<!-- wp:paragraph -->\n<p class=\"\">We build with modern architecture principles so solutions can grow with the organization.<\/p>\n<!-- \/wp:paragraph --><\/div>\n<!-- \/wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":3,\"className\":\"wp-block-heading\"} -->\n<h3 class=\"wp-block-heading\" id=\"h-actionable-intelligence\">Actionable Intelligence<\/h3>\n<!-- \/wp:heading -->\n\n<!-- wp:paragraph -->\n<p class=\"\">We help companies move beyond dashboards into recommendations, signals, and decision support.<\/p>\n<!-- \/wp:paragraph --><\/div>\n<!-- \/wp:column --><\/div>\n<!-- \/wp:columns --><\/div>\n<!-- \/wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"className\":\"nfd-container is-style-nfd-theme-white\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"72px\",\"right\":\"24px\",\"bottom\":\"72px\",\"left\":\"24px\"},\"blockGap\":\"40px\"}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"960px\"}} -->\n<div class=\"nfd-container is-style-nfd-theme-white wp-block-group alignfull\" style=\"padding-top:72px;padding-right:24px;padding-bottom:72px;padding-left:24px\"><!-- wp:heading {\"textAlign\":\"center\",\"className\":\"wp-block-heading nfd-text-xl nfd-text-balance\"} -->\n<h2 class=\"wp-block-heading nfd-text-xl nfd-text-balance has-text-align-center\" id=\"h-from-data-to-decisions\">From Data to Decisions<\/h2>\n<!-- \/wp:heading -->\n\n<!-- wp:columns {\"style\":{\"spacing\":{\"blockGap\":{\"top\":\"20px\",\"left\":\"20px\"}}}} -->\n<div class=\"wp-block-columns\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:paragraph -->\n<p class=\"\"><strong>1. Connect<\/strong><br>Bring together data across systems, teams, and business functions.<\/p>\n<!-- \/wp:paragraph --><\/div>\n<!-- \/wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:paragraph -->\n<p class=\"\"><strong>2. Understand<\/strong><br>Identify patterns, risks, trends, and performance opportunities.<\/p>\n<!-- \/wp:paragraph --><\/div>\n<!-- \/wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:paragraph -->\n<p class=\"\"><strong>3. Act<\/strong><br>Use AI-powered insights to guide better decisions and measurable outcomes.<\/p>\n<!-- \/wp:paragraph --><\/div>\n<!-- \/wp:column --><\/div>\n<!-- \/wp:columns --><\/div>\n<!-- \/wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"className\":\"nfd-container is-style-nfd-theme-light\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"72px\",\"right\":\"24px\",\"bottom\":\"72px\",\"left\":\"24px\"},\"blockGap\":\"24px\"}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"860px\"}} -->\n<div class=\"nfd-container is-style-nfd-theme-light wp-block-group alignfull\" style=\"padding-top:72px;padding-right:24px;padding-bottom:72px;padding-left:24px\"><!-- wp:heading {\"textAlign\":\"center\",\"className\":\"wp-block-heading nfd-text-xl nfd-text-balance\"} -->\n<h2 class=\"wp-block-heading nfd-text-xl nfd-text-balance has-text-align-center\" id=\"h-our-mission\">Our Mission<\/h2>\n<!-- \/wp:heading -->\n\n<!-- wp:paragraph {\"align\":\"center\",\"className\":\"nfd-text-md\"} -->\n<p class=\"nfd-text-md has-text-align-center\">Our mission is to help organizations unlock the full value of their data through intelligent, practical, and outcome-focused AI solutions.<\/p>\n<!-- \/wp:paragraph -->\n\n<!-- wp:paragraph {\"align\":\"center\",\"className\":\"nfd-text-md nfd-text-faded\"} -->\n<p class=\"nfd-text-md nfd-text-faded has-text-align-center\">We build technology that empowers teams, improves decision-making, and turns data into a strategic advantage.<\/p>\n<!-- \/wp:paragraph --><\/div>\n<!-- \/wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"className\":\"nfd-container\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"80px\",\"right\":\"24px\",\"bottom\":\"80px\",\"left\":\"24px\"},\"blockGap\":\"28px\"},\"color\":{\"background\":\"#111827\",\"text\":\"#ffffff\"}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"860px\"}} -->\n<div class=\"nfd-container wp-block-group alignfull has-text-color has-background\" style=\"color:#ffffff;background-color:#111827;padding-top:80px;padding-right:24px;padding-bottom:80px;padding-left:24px\"><!-- wp:heading {\"textAlign\":\"center\",\"className\":\"wp-block-heading nfd-text-xl nfd-text-balance\"} -->\n<h2 class=\"wp-block-heading nfd-text-xl nfd-text-balance has-text-align-center\" id=\"h-ready-to-unlock-the-value-of-your-data\">Ready to Unlock the Value of Your Data?<\/h2>\n<!-- \/wp:heading -->\n\n<!-- wp:paragraph {\"align\":\"center\",\"className\":\"nfd-text-md\"} -->\n<p class=\"nfd-text-md has-text-align-center\">Aletheon Labs helps organizations turn information into clarity, insight, and action.<\/p>\n<!-- \/wp:paragraph -->\n\n<!-- wp:paragraph {\"align\":\"center\",\"className\":\"nfd-text-md\"} -->\n<p class=\"nfd-text-md has-text-align-center\"><strong>Let\u2019s build smarter business intelligence together.<\/strong><\/p>\n<!-- \/wp:paragraph -->\n\n<!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"backgroundColor\":\"white\",\"textColor\":\"black\",\"className\":\"is-style-fill\"} -->\n<div class=\"is-style-fill wp-block-button\"><a class=\"wp-block-button__link has-black-color has-white-background-color has-text-color has-background wp-element-button\" href=\"mailto:contact@aletheonlabs.com?subject=Aletheon%20Labs%20Website%20Inquiry\">Connect With Us<\/a><\/div>\n<!-- \/wp:button --><\/div>\n<!-- \/wp:buttons --><\/div>\n<!-- \/wp:group -->\n\n<!-- wp:paragraph -->\n<p class=\"\"><\/p>\n<!-- \/wp:paragraph -->","post_title":"About","post_excerpt":"","post_status":"publish","comment_status":"closed","ping_status":"closed","post_password":"","post_name":"about","to_ping":"","pinged":"","post_modified":"2026-04-30 02:07:15","post_modified_gmt":"2026-04-30 02:07:15","post_content_filtered":"","post_parent":0,"guid":"https:\/\/aletheonlabs.com\/about\/","menu_order":0,"post_type":"page","post_mime_type":"","comment_count":"0","url":"https:\/\/aletheonlabs.com\/about\/"}
